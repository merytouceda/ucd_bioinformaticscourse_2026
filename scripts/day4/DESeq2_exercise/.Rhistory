library(pheatmap)   # heatmap plotting
# load data
Gene_matrix <- read.table("~/Documents/GitHub/omics_with_R/data/Gene_matrix.txt", sep = "\t", header = TRUE)
View(Gene_matrix)
glimpse(Gene_matrix)
dim(Gene_matrix)
table(Gene_matrix)
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE))
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE)
View(pheno_data)
colnames(pheno_data)
rownames(pheno_data)
class(pheno_data$Day)
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE) %>%
mutate(Day = factor(Day)) #%>%              # treat Day as a categorical variable
class(pheno_data$Day)
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE) %>%
mutate(Day = factor(Day)) %>%              # treat Day as a categorical variable
column_to_rownames("Sample_ID") #%>%
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE) %>%
mutate(Day = factor(Day)) %>%              # treat Day as a categorical variable
column_to_rownames("Sample_ID") %>%
mutate(Sample_ID = rownames(.))
pheno_data <- read.table("~/Documents/GitHub/omics_with_R/data/Metadata.txt", sep = "\t", header = TRUE) %>%
mutate(Day = factor(Day)) %>%              # treat Day as a categorical variable
column_to_rownames("Sample_ID") %>%
mutate(Sample_ID = rownames())
rownames(pheno_data) == colnames(Gene_matrix)
all(rownames(pheno_data) == colnames(Gene_matrix))
# DESeqDataSetFromMatrix needs an integer matrix + metadata + experimental design
dds <- DESeqDataSetFromMatrix(Gene_matrix, pheno_data, design = ~ Day)
View(dds)
dim(dds)
smallestGroupSize <- 3
keep <- rowSums(counts(dds) >= 100) >= smallestGroupSize
keep
dds <- DESeq(dds)
View(dds)
res_D7_vs_D0  <- results(dds, contrast = c("Day", "D7",  "D0"))
View(res_D7_vs_D0)
summary(res_D7_vs_D0)
res_D14_vs_D0 <- results(dds, contrast = c("Day", "D14", "D0"))
summary(res_D14_vs_D0)
plotMA(res_D7_vs_D0,  main = "D7 vs D0",  ylim = c(-5, 5))
