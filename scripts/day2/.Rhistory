library(igraph)
library(ggraph)
# Pick your module of interest
module_of_interest <- "turquoise"
# Get genes in that module
module_genes <- names(net$colors)[net$colors == module_of_interest]
# Subset the expression matrix to just those genes
datExpr_module <- datExpr[, module_genes]
# Compute correlations between genes in the module
cor_matrix <- cor(datExpr_module)
# Keep only strong correlations to avoid a hairball
# Adjust threshold depending on how dense you want the network
threshold <- 0.97
cor_matrix[abs(cor_matrix) < threshold] <- 0
diag(cor_matrix) <- 0  # remove self-loops
# Build igraph object from the adjacency matrix
g <- graph_from_adjacency_matrix(
cor_matrix,
mode    = "undirected",
weighted = TRUE,
diag    = FALSE
)
# Remove isolated nodes (genes with no connections above threshold)
g <- delete_vertices(g, which(degree(g) == 0))
# Add kME as a vertex attribute — used to size hub genes larger
kME_col <- paste0("kME", module_of_interest)
kme_vals <- kME[names(V(g)), kME_col]
V(g)$kme <- kme_vals
# Build the edge list manually so we can keep the sign
cor_matrix_signed <- cor(datExpr_module)
# Apply threshold but keep sign
cor_matrix_signed[abs(cor_matrix_signed) < threshold] <- 0
diag(cor_matrix_signed) <- 0
# Build graph with absolute values for layout weights
g <- graph_from_adjacency_matrix(
abs(cor_matrix_signed),
mode     = "undirected",
weighted = TRUE,
diag     = FALSE
)
# Remove isolated nodes
g <- delete_vertices(g, which(degree(g) == 0))
# Add kME as node attribute
kME_col <- paste0("kME", module_of_interest)
kme_vals <- kME[names(V(g)), kME_col]
V(g)$kme <- kme_vals
# Now recover the original signed correlation for each edge
# and add it as an edge attribute
el <- as_edgelist(g)
signed_weights <- cor_matrix_signed[el]   # look up sign for each edge
E(g)$signed_weight <- signed_weights
E(g)$edge_sign <- ifelse(signed_weights > 0, "positive", "negative")
# Plot
ggraph(g, layout = "fr") +
geom_edge_link(
aes(color = edge_sign, alpha = abs(signed_weight)),
show.legend = TRUE
) +
scale_edge_color_manual(
values = c("positive" = "#E74C3C", "negative" = "#3498DB"),
name   = "Correlation"
) +
scale_edge_alpha_continuous(range = c(0.2, 0.8), guide = "none") +
geom_node_point(aes(size = kme), color = module_of_interest, alpha = 0.9) +
geom_node_text(aes(label = name, size = kme),
repel = TRUE, max.overlaps = 20, show.legend = FALSE) +
scale_size_continuous(range = c(2, 8), name = "kME") +
theme_graph() +
ggtitle(paste0("Co-expression network — ", module_of_interest, " module"),
subtitle = "Red = positive correlation, Blue = negative correlation")
